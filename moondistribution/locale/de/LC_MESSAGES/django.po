msgstr "Als SIG hinzufügen"

#: views.py:60
msgid ""
"The task queue is not reachable right now – please try again in a few "
"minutes."
msgstr ""
"Die Task-Warteschlange ist gerade nicht erreichbar – bitte in ein paar "
"Minuten noch einmal versuchen."

#: views.py:207 views.py:679
msgid "Applications for this round are not open."
msgstr "Für diese Runde läuft gerade keine Bewerbung."

#: views.py:215
#, python-format
msgid ""
"%(corp)s has been in the alliance since %(joined)s – corps can apply after "
"%(months)s months, i.e. from %(end)s."
msgstr ""
"%(corp)s ist seit %(joined)s in der Allianz – Corps können sich nach "
"%(months)s Monaten bewerben, also ab %(end)s."

#: views.py:222
msgid "Officers can make an exception on the Corps page."
msgstr "Officer können auf der Corps-Seite eine Ausnahme machen."

#: views.py:259
#, python-format
msgid "Application for %(corp)s saved."
msgstr "Bewerbung für %(corp)s gespeichert."

#: views.py:281
msgid "The round is no longer open."
msgstr "Die Runde ist nicht mehr offen."

#: views.py:284
msgid "Application withdrawn."
msgstr "Bewerbung zurückgezogen."

#: views.py:337
msgid "Round created as draft. Open it when everything is set."
msgstr "Runde als Entwurf angelegt. Öffne sie, wenn alles passt."

#: views.py:354
msgid "A distributed round can't be edited anymore."
msgstr "Eine verteilte Runde kann nicht mehr bearbeitet werden."

#: views.py:361
msgid "Round saved."
msgstr "Runde gespeichert."

#: views.py:374
msgid "Add at least one moon to the round first."
msgstr "Füge der Runde zuerst mindestens einen Mond hinzu."

#: views.py:384
#, python-format
msgid ""
"Round is open for applications until %(end)s EVE time – then it is "
"distributed automatically."
msgstr ""
"Die Runde ist bis %(end)s EVE-Zeit für Bewerbungen offen – danach wird "
"automatisch verteilt."

#: views.py:400
msgid "Applications closed – distribution is running, reload in a moment."
msgstr ""
"Bewerbung geschlossen – die Verteilung läuft, lade die Seite gleich neu."

#: views.py:402
msgid ""
"The round is closed; start the distribution with 'Re-run distribution' "
"later."
msgstr ""
"Die Runde ist geschlossen; starte die Verteilung später mit „Verteilung neu "
"starten“."

#: views.py:413
msgid "Distribution restarted – reload in a moment."
msgstr "Verteilung neu gestartet – lade die Seite gleich neu."

#: views.py:424
msgid "Draft deleted."
msgstr "Entwurf gelöscht."

#: views.py:434 views.py:457
msgid "The round is already distributed – bonuses can't be changed anymore."
msgstr ""
"Die Runde ist schon verteilt – Boni können nicht mehr geändert werden."

#: views.py:443
msgid "Bonus saved."
msgstr "Bonus gespeichert."

#: views.py:460
msgid "Bonus removed."
msgstr "Bonus entfernt."

#: views.py:474
msgid "Please choose a corp of the alliance."
msgstr "Bitte wähle eine Corp der Allianz aus."

#: views.py:524
msgid "No moons selected."
msgstr "Keine Monde ausgewählt."

#: views.py:527
#, python-format
msgid "Rarity set for %(n)s moons."
msgstr "Rarity für %(n)s Monde gesetzt."

#: views.py:530
#, python-format
msgid "%(n)s moons updated."
msgstr "%(n)s Monde aktualisiert."

#: views.py:532
msgid "Unknown action."
msgstr "Unbekannte Aktion."

#: views.py:550
msgid "No moons recognised in the pasted text."
msgstr "Im eingefügten Text wurden keine Monde erkannt."

#: views.py:554
msgid "Import started – you get a notification with the result in a moment."
msgstr ""
"Import gestartet – du bekommst gleich eine Benachrichtigung mit dem "
"Ergebnis."

#: views.py:570
msgid "Moon saved."
msgstr "Mond gespeichert."

#: views.py:580
msgid ""
"Import from Corptools started – you get a notification with the result."
msgstr ""
"Import aus Corptools gestartet – du bekommst eine Benachrichtigung mit dem "
"Ergebnis."

#: views.py:591
msgid "Settings saved."
msgstr "Einstellungen gespeichert."

#: views.py:646
#, python-format
msgid "%(corp)s may apply despite its probation."
msgstr "%(corp)s darf sich trotz Probezeit bewerben."

#: views.py:648
#, python-format
msgid "Exception for %(corp)s removed."
msgstr "Ausnahme für %(corp)s entfernt."

#: views.py:657
msgid ""
"Join dates are being updated from ESI – you get a notification when done."
msgstr ""
"Die Beitrittsdaten werden aus der ESI aktualisiert – du bekommst eine "
"Benachrichtigung, wenn es fertig ist."

#: views.py:683
msgid "Please choose at least one file."
msgstr "Bitte mindestens eine Datei auswählen."

#: views.py:687
#, python-format
msgid "%(file)s: application of %(corp)s with %(n)s moons saved."
msgstr "%(file)s: Bewerbung von %(corp)s mit %(n)s Monden gespeichert."

#: views.py:691
#, python-format
msgid "%(file)s: not imported – %(reason)s"
msgstr "%(file)s: nicht importiert – %(reason)s"

#: views.py:717
msgid "You do not lead a SIG."
msgstr "Du leitest keine SIG."

#: views.py:740
#, python-format
msgid "Only the leaders of %(sig)s can claim moons for it."
msgstr "Nur die Leiter von %(sig)s können Monde für sie claimen."

#: views.py:778
#, python-format
msgid ""
"Claims of %(sig)s saved – %(n)s new, waiting for approval by a Mining "
"Officer."
msgstr ""
"Claims von %(sig)s gespeichert – %(n)s neu, warten auf Freigabe durch einen "
"Mining Officer."

#: views.py:798
msgid "The round is already closed."
msgstr "Die Runde ist schon geschlossen."

#: views.py:811
msgid "Claim updated."
msgstr "Claim aktualisiert."

#: views.py:827
#, python-format
msgid "%(n)s claims of %(sig)s approved."
msgstr "%(n)s Claims von %(sig)s freigegeben."

#: views.py:841
#, python-format
msgid "SIG %(sig)s saved."
msgstr "SIG %(sig)s gespeichert."

#: views.py:852
#, python-format
msgid "SIG %(sig)s is now %(state)s."
msgstr "SIG %(sig)s ist jetzt %(state)s."

#: views.py:853
msgid "active"
msgstr "aktiv"

#: views.py:853
msgid "inactive"
msgstr "inaktiv"
